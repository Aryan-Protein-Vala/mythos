# Server-side only — never expose these to the browser (no VITE_ prefix).
# Copy to .env.local for local dev; set in Vercel project env vars for production.

# OpenRouter API key used by the /api/architect server route.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenRouter model id. "openrouter/free" routes across free models.
OPENROUTER_MODEL=openrouter/free
